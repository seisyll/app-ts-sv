{
	"enabledPlugins": {
		"ruflo-core@ruflo": true,
		"ruflo-rag-memory@ruflo": true
	},
	"env": {
		"CLAUDE_FLOW_MCP_TOOLS": "memory"
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup|resume",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh",
						"timeout": 300
					}
				]
			}
		]
	}
}
