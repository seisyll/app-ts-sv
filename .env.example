# Copy to .env ( bun loads it for every `bun run` script ).

# ── Database ( local: docker-compose.dev.yml ) ──
POSTGRES_PASSWORD=postgres
# Owner: migrations, provisioning, seeding. Never used by the running app.
DATABASE_OWNER_URL=postgresql://postgres:postgres@127.0.0.1:5433/app
# The app connects as app_rls, so row-level security applies. db:provision sets this password.
APP_RLS_PASSWORD=change-me-app-rls
DATABASE_URL=postgresql://app_rls:change-me-app-rls@127.0.0.1:5433/app

# ── Client ──
# Which config/clients/<name>.ts to build: its modules and its public-site theme. Unset:
# default.ts ( every module ). Restart the dev server after changing it.
# CLIENT=default

# ── Redis ( optional ) ──
# Shared counters for the sign-in throttle ( docker-compose.dev.yml runs one ). Unset: the
# throttle is off and better-auth's per-IP limits remain.
REDIS_URL=redis://127.0.0.1:6380

# ── Media ──
# Where uploads are written ( a writable volume in Docker ). Default ./uploads.
UPLOAD_ROOT=./uploads
# adapter-node's request-body cap ( production only; vite dev has none ). Keep it above the
# per-file caps in src/lib/media.ts ( 10 MB ), or uploads fail with a bare 413.
BODY_SIZE_LIMIT=12M

# ── Tenancy ──
# single: one tenant ( TENANT_SLUG ). shared: tenant from the host — its custom domain,
# else <slug>.APP_DOMAIN.
TENANCY=single
TENANT_SLUG=default
TENANT_NAME=Acme Inc
APP_DOMAIN=localhost

# ── Auth ──
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Single tenancy: the app's public URL. ( Shared tenancy derives it from each request. )
BETTER_AUTH_URL=http://localhost:5173
# Let visitors create accounts. Off: accounts come from an admin ( or the seed ).
AUTH_SIGNUP=false
# First admin, created by bun run db:seed in TENANT_SLUG.
ADMIN_EMAIL=admin@example.test
ADMIN_NAME=Admin
ADMIN_PASSWORD=
# A demo admin with a known password, for local work and coding agents ( bun run db:seed;
# never created when NODE_ENV=production ). Empty either one to skip it.
DEMO_EMAIL=demo@example.test
DEMO_PASSWORD=demo-password
