# The stack ( docker-compose.yml reads this ). first-run.sh writes .env from this file.

# The image CI pushes ( .github/workflows/image.yml ): ghcr.io/<owner>/<repo>:latest, or a
# version tag ( :v1.2.0 ) to pin one.
IMAGE=ghcr.io/owner/repo:latest

# The site's domain; its DNS A/AAAA records point at this server. Shared tenancy also needs
# *.<domain> pointing here for the workspaces' subdomains.
DOMAIN=example.com

# Hex only ( they go into connection URLs ): openssl rand -hex 24
POSTGRES_PASSWORD=
APP_RLS_PASSWORD=

BACKUP_KEEP_DAYS=14
