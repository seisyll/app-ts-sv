# The app's settings ( the app and migrate containers read this ). The database and Redis
# URLs come from docker-compose.yml; never put the owner's password here.
# first-run.sh writes app.env from this file. Every key is explained in /.env.example.

# Keep it above the media library's per-file cap ( 10 MB ).
BODY_SIZE_LIMIT=12M

# single: one workspace ( TENANT_SLUG ). shared: a workspace per host — <slug>.APP_DOMAIN,
# or its custom domain.
TENANCY=single
TENANT_SLUG=default
TENANT_NAME=Acme Inc
APP_DOMAIN=example.com

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Single tenancy: https://<DOMAIN>.
BETTER_AUTH_URL=https://example.com
AUTH_SIGNUP=false

# false keeps search engines out entirely — for a staging copy.
# SEO_INDEX=false

# The first admin, created by the migrate step when missing. Remove the password once you
# have signed in and changed it: an existing account is never touched.
ADMIN_EMAIL=
ADMIN_NAME=Admin
ADMIN_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
