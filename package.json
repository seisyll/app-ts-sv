{
	"name": "app-ts-sv",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && prisma generate || echo ''",
		"check": "svelte-kit sync && bun run i18n && svelte-check --tsconfig ./tsconfig.json",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:server": "vitest run --project server",
		"test:client": "vitest run --project client",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose -f docker-compose.dev.yml down",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:provision": "bun scripts/db-provision.ts",
		"db:seed": "bun prisma/seed.ts",
		"db:deploy": "prisma migrate deploy && bun scripts/db-provision.ts && bun prisma/seed.ts",
		"db:setup": "bun run db:up && bun run db:migrate && bun run db:provision && bun run db:seed",
		"db:reset": "docker compose -f docker-compose.dev.yml down -v && bun run db:setup",
		"tenant:modules": "bun scripts/tenant-modules.ts",
		"tenant:quota": "bun scripts/tenant-quota.ts",
		"generate:palettes": "bun run scripts/generate-palettes.ts",
		"sync:ui": "bun run scripts/sync-ui.ts",
		"apple:secret": "bun scripts/apple-client-secret.ts"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.11",
		"@electric-sql/pglite-socket": "^0.2.14",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/cormorant-garamond": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.1",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@number-flow/svelte": "^0.4.2",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^8.21.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@valibot/to-json-schema": "^1.8.0",
		"@vitest/browser": "^4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"bits-ui": "^2.20.0",
		"clsx": "^2.1.1",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"layerchart": "^2.8.1",
		"maska": "^3.2.2",
		"mode-watcher": "^1.1.0",
		"pino-pretty": "^13.2.0",
		"playwright": "1.64.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"valibot": "^1.5.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.5",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-image": "^3.32.0",
		"@tiptap/extension-text-align": "^3.32.0",
		"@tiptap/extension-typography": "^3.32.0",
		"@tiptap/extensions": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"@tiptap/static-renderer": "^3.32.0",
		"better-auth": "^1.7.12",
		"croner": "^10.0.1",
		"ioredis": "^6.0.0",
		"marked": "^18.1.1",
		"nodemailer": "^10.2.0",
		"pg": "^8.23.1",
		"pino": "^10.4.0",
		"prisma": "^7.10.1",
		"sharp": "^0.35.5",
		"svelte-tiptap": "^3.0.2",
		"write-excel-file": "^4.1.1"
	}
}
