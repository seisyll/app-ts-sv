{
	"name": "app-ts-sv",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && prisma generate || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:server": "vitest run --project server",
		"test:client": "vitest run --project client",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose -f docker-compose.dev.yml down",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy",
		"db:provision": "bun scripts/db-provision.ts",
		"db:seed": "bun prisma/seed.ts",
		"db:setup": "bun run db:up && bun run db:migrate && bun run db:provision && bun run db:seed",
		"db:reset": "docker compose -f docker-compose.dev.yml down -v && bun run db:setup",
		"tenant:modules": "bun scripts/tenant-modules.ts",
		"generate:palettes": "bun run scripts/generate-palettes.ts",
		"sync:ui": "bun run scripts/sync-ui.ts",
		"apple:secret": "bun scripts/apple-client-secret.ts"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.4.3",
		"@electric-sql/pglite-socket": "^0.1.1",
		"@fontsource-variable/cormorant-garamond": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@inlang/paraglide-js": "^2.21.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/table-core": "^8.21.3",
		"@types/node": "^24.13.3",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.21.0",
		"@valibot/to-json-schema": "^1.0.0",
		"@vitest/browser": "^4.1.12",
		"@vitest/browser-playwright": "^4.1.12",
		"@vitest/coverage-v8": "^4.1.12",
		"bits-ui": "^2.18.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"playwright": "1.61.1",
		"prisma": "^7.9.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"svelte-sonner": "^1.2.0",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"valibot": "^1.4.2",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"vitest-browser-svelte": "^3.0.0"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@tiptap/core": "^3.27.3",
		"@tiptap/extension-image": "^3.27.3",
		"@tiptap/extension-text-align": "^3.27.3",
		"@tiptap/extension-typography": "^3.27.3",
		"@tiptap/extensions": "^3.27.3",
		"@tiptap/pm": "^3.27.3",
		"@tiptap/starter-kit": "^3.27.3",
		"@tiptap/static-renderer": "^3.27.3",
		"better-auth": "^1.6.23",
		"ioredis": "^6.0.0",
		"nodemailer": "^10.1.7",
		"pg": "^8.22.0",
		"sharp": "^0.35.3",
		"svelte-tiptap": "^3.0.1"
	}
}
