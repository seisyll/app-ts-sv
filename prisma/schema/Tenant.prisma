// Control plane: the tenants themselves. Not tenant-scoped ( no RLS ); the app role can
// only read it — tenants are created by the owner ( seed / provisioning ).
model Tenant {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug      String       @unique
  name      String
  // Shared tenancy: a custom domain; otherwise <slug>.APP_DOMAIN.
  domain    String?      @unique
  status    TenantStatus @default(active)
  // Modules this workspace has switched off, of those the build ships ( config/modules.ts ).
  // Empty: everything the build ships. Set with: bun run tenant:modules
  modulesOff String[]    @default([]) @map("modules_off")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  users         User[]
  sessions      Session[]
  accounts      Account[]
  verifications Verification[]
  rateLimits    RateLimit[]
  appearance    AppearanceSetting?
  media         Media[]

  notificationEvents      NotificationEvent[]
  notificationRecipients  NotificationRecipient[]
  notificationPreferences NotificationPreference[]

  mailSetting   MailSetting?
  mailTemplates MailTemplate[]

  @@map("tenants")
}

enum TenantStatus {
  active
  suspended

  @@map("tenant_status")
}
