// better-auth user ( + admin plugin fields ). Tenant-scoped: an account belongs to one
// tenant, and the same email may exist separately in another.
model User {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Stamped from the transaction's tenant when the app omits it ( it always does ).
  tenantId      String    @default(dbgenerated("app_current_tenant()")) @map("tenant_id") @db.Uuid
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  // A picture from a sign-in provider ( Google's ), as better-auth stores it.
  image         String?
  // An uploaded avatar ( src/lib/server/avatars.ts ), a media file; shown instead of `image`.
  // Deleting the file from the library falls back to `image`, then to initials.
  avatarId      String?   @map("avatar_id") @db.Uuid
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires") @db.Timestamptz
  // Personal appearance overrides; null follows the workspace ( AppearanceSetting ).
  appearancePalette String? @map("appearance_palette")
  appearanceStyle   String? @map("appearance_style")
  appearanceRadius  String? @map("appearance_radius")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions Session[]
  accounts Account[]
  uploads  Media[]   @relation("uploads")
  avatar   Media?    @relation("avatar", fields: [avatarId], references: [id], onDelete: SetNull)

  notifications           NotificationRecipient[]
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  signIns                 SignInEvent[]

  // better-auth lowercases emails, so plain uniqueness is case-insensitive in practice.
  @@unique([tenantId, email])
  @@map("users")
}
